# Copy this file to .env.local, then run the app.
#
# The frontend only needs these two public Convex URLs to connect to the
# shared backend (they ship in the client bundle, so they are not secrets):
EXPO_PUBLIC_CONVEX_URL=https://harmless-possum-685.convex.cloud
EXPO_PUBLIC_CONVEX_SITE_URL=https://harmless-possum-685.convex.site

# Only needed if you run the Convex CLI (npx convex dev) against your OWN
# deployment. Get your value by running `npx convex dev` once — it writes it
# here automatically. Leave it out if you just want to run the app.
# CONVEX_DEPLOYMENT=
