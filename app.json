{
  "expo": {
    "name": "LunaraFit",
    "slug": "LunaraFit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "lunarafit",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lunarafit.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FDFAF6",
        "foregroundImage": "./assets/icon.png"
      },
      "package": "com.lunarafit.app"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
